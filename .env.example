# REORG environment template. Copy to .env and fill in locally; never commit .env.
# Every variable the services and scripts read is listed here with no value.
# `npm run demo` (local sandbox) needs none of the secrets below.

# --- network ---------------------------------------------------------------
# sandbox | testnet  (mainnet is never used by this repo)
NETWORK=
NEAR_RPC_URL=
# optional API key for a keyed RPC provider (rate limits, roadmap R-12), sent as the x-api-key header
NEAR_RPC_API_KEY=

# --- deployed contracts ----------------------------------------------------
TOKEN_CONTRACT_ID=
REORG_CONTRACT_ID=
# root account you create on testnet; crowd accounts are c001.<root> ...
ROOT_ACCOUNT_ID=
ROOT_PRIVATE_KEY=
OWNER_ACCOUNT_ID=
# path to a JSON file overriding protocol/config.default.json at deploy
CONTRACT_CONFIG_PATH=

# --- boss service (apps/boss) ------------------------------------------------
BOSS_ACCOUNT_ID=
BOSS_PRIVATE_KEY=
BOSS_PORT=
BOSS_DB_PATH=
# allowed CORS origin for the web client
WEB_ORIGIN=
# scheduler: seconds between task openings, and fraction of the epoch the window stays open
EPOCH_SECONDS=
WINDOW_FRACTION=
# number of short warm-up tasks at boot (roadmap D-03) and their window in seconds
WARMUP_TASKS=
WARMUP_WINDOW_SECONDS=
# seconds to wait after closes_at before finalizing (finality margin)
FINALITY_MARGIN_SECONDS=
# tasks generated and self-checked ahead of time (default 7, shown in /healthz)
LOOKAHEAD_TASKS=
# difficulty: schedule (levels from LEVEL_SCHEDULE, cycling) | auto (spec 4.4: >90% passed +1, <50% -1)
LEVEL_MODE=
# comma list of levels 1-5, one per task, cycling (default 1,2,3,2,3,4,2)
LEVEL_SCHEDULE=
# fixed demo schedule, cipher:level per task, cycling (e.g. caesar:1,atbash:1,a1z26:2); overrides the above
PUZZLE_SCHEDULE=

# --- flavor text LLM (optional; templates are used when unset) -------------
# all three or none; any OpenAI-compatible chat-completions endpoint (base URL ends in /v1)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=
NEAR_AI_MODEL=

# --- demo faucet (D-09) ------------------------------------------------------
FAUCET_ENABLED=
FAUCET_ACCOUNT_ID=
FAUCET_PRIVATE_KEY=
# yoctoNEAR and token base units given to each burner
FAUCET_NEAR_AMOUNT=
FAUCET_TOKEN_AMOUNT=
FAUCET_RATE_LIMIT_PER_IP=

# --- simulated crowd and income (labeled SIMULATED everywhere) ---------------
# crowd keys are derived from this seed at runtime and never written to disk
CROWD_SEED=
CROWD_SIZE=
# yoctoNEAR deposited per epoch by the income bot (tag client_job)
INCOME_BOT_AMOUNT=
INCOME_BOT_ACCOUNT_ID=
INCOME_BOT_PRIVATE_KEY=

# --- web client (apps/web, exposed to the browser: no secrets here) ---------
VITE_NETWORK=
VITE_RPC_URL=
VITE_TOKEN_CONTRACT_ID=
VITE_REORG_CONTRACT_ID=
VITE_BOSS_URL=
# 1 enables the burner "demo player" wallet
VITE_DEMO=
