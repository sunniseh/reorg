      },
      "poses": {
        "emp.sit.front": {
          "view": "front",
          "use": "Seated, between tasks; new hire"
        },
        "emp.type": {
          "view": "side",
          "use": "Working: turned to the monitor while a task is open"
        },
        "emp.walk": {
          "view": "side",
          "use": "Rehire walk-in; mirror with scale.x = -1 to face left"
        },
        "emp.carry": {
          "view": "side",
          "use": "Layoff walk-out with the box"
        },
        "emp.visitor": {
