{
  "name": "reorg",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vectors": "python3 -I protocol/gen_vectors.py",
    "vectors:check": "python3 -I protocol/gen_vectors.py --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run vectors:check && npm run typecheck && npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
