{
  "name": "reorg",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "vectors": "python3 -I protocol/gen_vectors.py",
    "vectors:check": "python3 -I protocol/gen_vectors.py --check",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run vectors:check && npm run typecheck && npm test --workspaces --if-present && npm run contracts:test",
    "contracts:build": "sh scripts/contracts.sh build",
    "contracts:test": "sh scripts/contracts.sh test",
    "contracts:sandbox": "sh scripts/contracts.sh sandbox",
    "boss": "npm run start -w @reorg/boss",
    "boss:sandbox": "REORG_SANDBOX=1 npm test -w @reorg/chain-near -w @reorg/boss",
    "brand": "node brand/build.mjs",
    "art": "node art/build.mjs",
    "dev:live": "tsx scripts/dev-live.ts",
    "web": "npm run dev -w @reorg/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
